      "source": [
        "Xf = F[FULL]; mf, sf = Xf.mean(), Xf.std()\n",
        "Zf = standardise(Xf, mf, sf)\n",
        "m_full = fit_hmm(Zf)\n",
        "o_full = state_order(m_full, FULL)\n",
        "p_A = pd.Series(m_full.predict_proba(Zf)[:, o_full[-1]], index=F.index)     # smoothed\n",
        "p_B = pd.Series(forward_filter(m_full, Zf)[:, o_full[-1]], index=F.index)  # filtered\n",
        "p_C = WF[\"Full (+ USD/INR, Bank)\"][\"p_stress\"]\n",
        "\n",
        "print(\"Full-sample state summary (calm → stressed):\")\n",
        "summ = pd.DataFrame({\"mean daily ret %\": [ret_d[m_full.predict(Zf) == k].mean() * 100 for k in o_full],\n",
        "                     \"ann. vol %\": [ret_d[m_full.predict(Zf) == k].std() * np.sqrt(252) * 100 for k in o_full],\n",
        "                     \"share of days %\": [(m_full.predict(Zf) == k).mean() * 100 for k in o_full]},\n",
        "                    index=[\"calm\", \"normal\", \"stressed\"][:N_STATES])\n",
        "summ"
      ]
    },
