      "source": [
        "### 6.1 Is the difference statistically meaningful?\n",
        "A circular block bootstrap (21-day blocks, 2,000 resamples) gives confidence intervals for the HMM's Sharpe and max-drawdown difference against buy-and-hold. If an interval includes 0, that difference is not significant."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 15,
      "id": "74652076",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "74652076",
        "outputId": "0aad51a2-22aa-436c-bd40-9aff851ac72a"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "HMM full (prob-weighted)     vs Buy & hold: {'ΔSharpe 95% CI': array([-0.315,  0.882]), 'ΔMaxDD 95% CI (pp)': array([-0.8, 41.3])}\n",
            "Vol targeting                vs Buy & hold: {'ΔSharpe 95% CI': array([-0.158,  0.274]), 'ΔMaxDD 95% CI (pp)': array([-1.6, 19.2])}\n",
            "India VIX rule               vs Buy & hold: {'ΔSharpe 95% CI': array([-0.571,  0.401]), 'ΔMaxDD 95% CI (pp)': array([-10.1,  31.8])}\n"
          ]
        }
      ],
      "source": [
        "def block_bootstrap_diff(ra, rb, n_boot=2000, block=21, seed=0):\n",
        "    rng = np.random.default_rng(seed)\n",
        "    a, b = ra.values, rb.values; n = len(a); nb = int(np.ceil(n / block))\n",
        "    def sharpe(x): return x.mean() / x.std() * np.sqrt(252)\n",
        "    def mdd(x):\n",
        "        eq = np.cumprod(1 + x); return (eq / np.maximum.accumulate(eq) - 1).min()\n",
        "    ds, dd = [], []\n",
        "    for _ in range(n_boot):\n",
        "        starts = rng.integers(0, n, nb)\n",
        "        ix = ((starts[:, None] + np.arange(block)) % n).ravel()[:n]\n",
        "        ds.append(sharpe(a[ix]) - sharpe(b[ix])); dd.append(mdd(a[ix]) - mdd(b[ix]))\n",
        "    q = lambda v: np.percentile(v, [2.5, 97.5])\n",
        "    return {\"ΔSharpe 95% CI\": q(ds).round(3), \"ΔMaxDD 95% CI (pp)\": (q(dd) * 100).round(1)}\n",
        "\n",
        "for k in [\"HMM full (prob-weighted)\", \"Vol targeting\", \"India VIX rule\"]:\n",
        "    print(f\"{k:28s} vs Buy & hold:\", block_bootstrap_diff(RETS[k], RETS[\"Buy & hold\"]))"
      ]
    },
