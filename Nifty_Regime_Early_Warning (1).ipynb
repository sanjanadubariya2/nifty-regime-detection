ies\": {\n        \"dtype\": \"number\",\n        \"std\": 6.434625393005836,\n        \"min\": 11.91950464396285,\n        \"max\": 29.79876160990712,\n        \"num_unique_values\": 7,\n        \"samples\": [\n          11.91950464396285\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
