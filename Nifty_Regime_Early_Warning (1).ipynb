      "source": [
        "## 5. Regime model: walk-forward Gaussian HMM with filtered probabilities\n",
        "\n",
        "Each month:\n",
        "1. Fit a Gaussian HMM (full covariance, several random starts) on the previous `TRAIN_YEARS` of standardised features.\n",
        "2. **Align labels:** sort states by their mean realised volatility, so the \"stressed\" state is always the highest-volatility one. This fixes label switching between refits.\n",
        "3. Run the **forward algorithm** (filtering) up to each day of the next month. `P(stress at t)` uses observations up to *t* only.\n",
        "4. Estimate each state's daily-return mean and variance on the training window (for VaR in Section 9).\n",
        "\n",
        "`hmmlearn`'s `predict_proba` returns **smoothed** probabilities, which use the whole sequence including future days. That is why the forward filter is written by hand here."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "id": "7ae2627a",
      "metadata": {
        "id": "7ae2627a"
      },
      "outputs": [],
      "source": [
        "def fit_hmm(Z, k=N_STATES, seeds=SEEDS):\n",
        "    best, best_ll = None, -np.inf\n",
        "    for s in seeds:\n",
        "        m = GaussianHMM(n_components=k, covariance_type=\"full\", n_iter=200, tol=1e-4,\n",
        "                        random_state=s, min_covar=1e-3)\n",
        "        try:\n",
        "            m.fit(Z); ll = m.score(Z)\n",
        "        except Exception:\n",
        "            continue\n",
        "        if np.isfinite(ll) and ll > best_ll:\n",
        "            best, best_ll = m, ll\n",
        "    return best\n",
        "\n",
        "def forward_filter(model, Z):\n",
        "    # Filtered state probabilities P(s_t | z_1..z_t): causal, uses no future data.\n",
        "    K = model.n_components\n",
        "    logB = np.column_stack([multivariate_normal(model.means_[k], model.covars_[k],\n",
        "                                                allow_singular=True).logpdf(Z) for k in range(K)])\n",
        "    A, alpha = model.transmat_, np.zeros((len(Z), K))\n",
        "    prev = model.startprob_\n",
        "    for t in range(len(Z)):\n",
        "        pred = prev if t == 0 else prev @ A\n",
        "        b = np.exp(logB[t] - logB[t].max())\n",
        "        a = pred * b; s = a.sum()\n",
        "        alpha[t] = a / s if s > 0 and np.isfinite(s) else pred\n",
        "        prev = alpha[t]\n",
        "    return alpha\n",
        "\n",
        "def standardise(X, mu, sd):\n",
        "    return ((X - mu) / sd).clip(-5, 5).values\n",
        "\n",
        "def state_order(model, cols):\n",
        "    # Indices of states sorted from calmest to most stressed (by mean realised vol).\n",
        "    return np.argsort(model.means_[:, cols.index(\"log_rv21\")])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "id": "84ccb941",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "84ccb941",
        "outputId": "9c0f9ddc-0dc9-4009-e0a4-fb177c18bd82"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Out-of-sample period starts: 2016-05-24\n"
          ]
        }
      ],
      "source": [
        "TRAIN_DAYS = TRAIN_YEARS * 252\n",
        "OOS_START = F.index[TRAIN_DAYS]\n",
        "ret_d = lr.reindex(F.index)                      # daily log return, aligned with features\n",
        "\n",
        "def walk_forward(cols, refit_every=REFIT_EVERY, verbose=True):\n",
        "    # Walk-forward filtered stress probability, next-day state probs, and state return params.\n",
        "    X = F[cols]; n = len(X); start = TRAIN_DAYS\n",
        "    p_stress = pd.Series(np.nan, index=F.index)\n",
        "    p_next = pd.DataFrame(np.nan, index=F.index, columns=range(N_STATES))   # P(s_{t+1}) ordered calm→stress\n",
        "    mu_r = pd.DataFrame(np.nan, index=F.index, columns=range(N_STATES))\n",
        "    sd_r = pd.DataFrame(np.nan, index=F.index, columns=range(N_STATES))\n",
        "    t0 = time.time()\n",
        "    for b in range(start, n, refit_every):\n",
        "        e = min(b + refit_every, n)\n",
        "        tr = slice(b - TRAIN_DAYS, b)\n",
        "        Xtr = X.iloc[tr]; m_, s_ = Xtr.mean(), Xtr.std()\n",
        "        Ztr = standardise(Xtr, m_, s_)\n",
        "        model = fit_hmm(Ztr)\n",
        "        if model is None:\n",
        "            continue\n",
        "        order = state_order(model, cols)\n",
        "        # filter through the training window and into the next block (causal)\n",
        "        alpha = forward_filter(model, standardise(X.iloc[b - TRAIN_DAYS:e], m_, s_))[-(e - b):]\n",
        "        A = model.transmat_\n",
        "        p_stress.iloc[b:e] = alpha[:, order[-1]]\n",
        "        p_next.iloc[b:e] = (alpha @ A)[:, order]\n",
        "        # state-conditional daily return params, estimated on training data only\n",
        "        g = model.predict_proba(Ztr)[:, order]     # smoothing inside the past window is fine\n",
        "        r = ret_d.iloc[tr].values[:, None]\n",
        "        w = g / g.sum(axis=0, keepdims=True)\n",
        "        mu = (w * r).sum(axis=0); var = (w * (r - mu) ** 2).sum(axis=0)\n",
        "        mu_r.iloc[b:e] = mu; sd_r.iloc[b:e] = np.sqrt(np.maximum(var, 1e-10))\n",
        "    if verbose:\n",
        "        print(f\"{cols[-1]:>12} … {len(cols)} features | refits: {len(range(start, n, refit_every))} | {time.time()-t0:.0f}s\")\n",
        "    return dict(p_stress=p_stress, p_next=p_next, mu_r=mu_r, sd_r=sd_r)\n",
        "\n",
        "print(\"Out-of-sample period starts:\", OOS_START.date())"
      ]
    },
