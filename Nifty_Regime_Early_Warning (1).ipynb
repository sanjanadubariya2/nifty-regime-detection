      "source": [
        "# ---------------- configuration ----------------\n",
        "START        = \"2011-01-01\"\n",
        "END          = None            # None = today\n",
        "DATA_DIR     = \"data\"          # downloaded series are cached here as CSV\n",
        "USE_SYNTHETIC = False        # True = offline test data (for checking the pipeline only)\n",
        "\n",
        "N_STATES     = 3               # calm / normal / stressed\n",
        "TRAIN_YEARS  = 5               # rolling training window for the HMM\n",
        "REFIT_EVERY  = 21              # refit monthly (trading days)\n",
        "SEEDS        = (0, 1, 2)       # several EM starts, keep the best likelihood\n",
        "EMA_SPAN     = 5               # causal smoothing of the stress probability (persistence filter)\n",
        "\n",
        "COST_BPS     = 10              # cost per unit of turnover, in basis points (assumption: ETF brokerage + STT + impact)\n",
        "CASH_YIELD   = 0.065           # assumed annual yield on the cash leg (assumption)\n",
        "VOL_TARGET   = 0.15            # for the volatility-targeting baseline\n",
        "DD_THRESHOLD = 0.10            # a 'stress episode' = Nifty peak-to-trough fall of at least 10%\n",
        "VAR_ALPHA    = 0.01            # 99% one-day VaR"
      ]
    },
