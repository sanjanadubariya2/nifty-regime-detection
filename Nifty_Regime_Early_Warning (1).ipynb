      "source": [
        "wf = WF[\"Full (+ USD/INR, Bank)\"]\n",
        "r_next = ret_d.shift(-1)\n",
        "\n",
        "def mixture_quantile(pi, mu, sd, a=VAR_ALPHA):\n",
        "    f = lambda q: (pi * norm.cdf((q - mu) / sd)).sum() - a\n",
        "    lo, hi = (mu - 12 * sd).min(), (mu + 12 * sd).max()\n",
        "    return brentq(f, lo, hi)\n",
        "\n",
        "idx_v = wf[\"p_next\"].dropna().index\n",
        "q_regime = pd.Series([mixture_quantile(wf[\"p_next\"].loc[d].values, wf[\"mu_r\"].loc[d].values,\n",
        "                                       wf[\"sd_r\"].loc[d].values) for d in idx_v], index=idx_v)\n",
        "ewma_var = ret_d.pow(2).ewm(alpha=0.06).mean()\n",
        "VAR = {\"Historical 500d\": ret_d.rolling(500).quantile(VAR_ALPHA),\n",
        "       \"Normal 252d\":     ret_d.rolling(252).mean() + norm.ppf(VAR_ALPHA) * ret_d.rolling(252).std(),\n",
        "       \"EWMA (λ=0.94)\":   norm.ppf(VAR_ALPHA) * np.sqrt(ewma_var),\n",
        "       \"Regime mixture (ours)\": q_regime}\n",
        "\n",
        "def kupiec(breaches, p=VAR_ALPHA):\n",
        "    n, x = len(breaches), int(breaches.sum()); ph = x / n\n",
        "    if x == 0: lr = -2 * n * np.log(1 - p)\n",
        "    else: lr = -2 * ((n - x) * np.log(1 - p) + x * np.log(p) - (n - x) * np.log(1 - ph) - x * np.log(ph))\n",
        "    return x, ph * 100, 1 - chi2.cdf(lr, 1)\n",
        "\n",
        "in_stress = pd.Series(False, index=F.index)\n",
        "for _, e in episodes.iterrows(): in_stress.loc[e.peak:e.trough] = True\n",
        "\n",
        "rows = {}\n",
        "for k, q in VAR.items():\n",
        "    d = q.reindex(F.index).loc[OOS_START:].dropna().index.intersection(r_next.dropna().index)\n",
        "    br = (r_next.loc[d] < q.loc[d])\n",
        "    x, rate, pv = kupiec(br)\n",
        "    s = in_stress.loc[d]\n",
        "    rows[k] = {\"breaches\": x, \"breach rate %\": rate, \"Kupiec p-value\": pv,\n",
        "               \"breach rate in stress %\": br[s].mean() * 100 if s.any() else np.nan,\n",
        "               \"avg VaR % (lower = more capital)\": -q.loc[d].mean() * 100}\n",
        "var_table = pd.DataFrame(rows).T\n",
        "print(f\"Target breach rate: {VAR_ALPHA*100:.1f}%\")\n",
        "var_table"
      ]
    },
