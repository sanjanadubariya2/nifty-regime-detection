       \"std\": 0.28273089265345563,\n        \"min\": 2.0740605710211546,\n        \"max\": 2.721048909668813,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          2.1905049364581033,\n          2.3793130709539105,\n          2.721048909668813\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
