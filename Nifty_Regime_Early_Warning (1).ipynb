      "source": [
        "nifty = core[\"NIFTY\"]\n",
        "lr = np.log(nifty).diff()\n",
        "\n",
        "F = pd.DataFrame(index=cal)\n",
        "F[\"ret5\"]      = np.log(nifty).diff(5)\n",
        "F[\"log_rv21\"]  = np.log(lr.rolling(21).std() * np.sqrt(252))\n",
        "F[\"log_vix\"]   = np.log(core[\"INDIAVIX\"])\n",
        "F[\"vix_chg5\"]  = np.log(core[\"INDIAVIX\"]).diff(5)\n",
        "\n",
        "sma50 = cons.rolling(50).mean()\n",
        "above = (cons > sma50).astype(float).where(sma50.notna())\n",
        "F[\"breadth50\"]   = above.mean(axis=1).where(above.notna().sum(axis=1) >= 20)\n",
        "sec21 = np.log(sect).diff(21)\n",
        "F[\"sector_disp\"] = sec21.std(axis=1).where(sec21.notna().sum(axis=1) >= 4)\n",
        "F[\"usdinr21\"]    = np.log(core[\"USDINR\"]).diff(21)\n",
        "F[\"bank_rel21\"]  = np.log(core[\"BANKNIFTY\"]).diff(21) - np.log(nifty).diff(21)\n",
        "\n",
        "FEATURE_SETS = {\n",
        "    \"Base (ret, vol)\":        [\"ret5\", \"log_rv21\"],\n",
        "    \"+ India VIX\":            [\"ret5\", \"log_rv21\", \"log_vix\", \"vix_chg5\"],\n",
        "    \"+ Breadth & dispersion\": [\"ret5\", \"log_rv21\", \"log_vix\", \"vix_chg5\", \"breadth50\", \"sector_disp\"],\n",
        "    \"Full (+ USD/INR, Bank)\": [\"ret5\", \"log_rv21\", \"log_vix\", \"vix_chg5\", \"breadth50\", \"sector_disp\",\n",
        "                               \"usdinr21\", \"bank_rel21\"],\n",
        "}\n",
        "FULL = FEATURE_SETS[\"Full (+ USD/INR, Bank)\"]\n",
        "\n",
        "F = F[FULL].dropna()\n",
        "print(f\"Feature rows: {len(F)}  ({F.index[0].date()} → {F.index[-1].date()})\")\n",
        "F.describe().T"
      ]
    },
