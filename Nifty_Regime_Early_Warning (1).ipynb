      "source": [
        "### 7.1 Case studies\n",
        "Named Indian market events. Some are not ≥10% drawdowns (e.g. the June 2024 election-result day), but they are useful stress tests of the signal."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 17,
      "id": "5bcf4dba",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 498
        },
        "id": "5bcf4dba",
        "outputId": "97afd5e1-dcc0-4a1e-abd5-e9c676121636"
      },
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1400x1280 with 8 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ],
      "source": [
        "EVENTS = {\"COVID crash (2020)\": (\"2020-01-01\", \"2020-07-31\"),\n",
        "          \"2022 selloff\":       (\"2021-12-01\", \"2022-08-31\"),\n",
        "          \"Election result day (Jun 2024)\": (\"2024-04-15\", \"2024-07-31\"),\n",
        "          \"2024–25 correction\": (\"2024-08-15\", \"2025-06-30\")}\n",
        "EVENTS = {k: v for k, v in EVENTS.items() if pd.Timestamp(v[0]) >= OOS_START and pd.Timestamp(v[0]) < F.index[-1]}\n",
        "if not EVENTS:   # synthetic data / short history: just show the deepest episodes\n",
        "    EVENTS = {f\"Episode {i+1}\": (str((e.peak - pd.Timedelta(days=60)).date()), str((e.trough + pd.Timedelta(days=60)).date()))\n",
        "              for i, e in episodes.nsmallest(4, \"depth\").iterrows()}\n",
        "if not EVENTS:\n",
        "    EVENTS = {\"Last 12 months\": (str(F.index[-252].date()), str(F.index[-1].date()))}\n",
        "\n",
