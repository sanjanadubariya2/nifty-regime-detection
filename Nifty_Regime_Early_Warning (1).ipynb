      "source": [
        "def drawdown_episodes(price, thresh=DD_THRESHOLD):\n",
        "    # (peak_date, trough_date, depth) for every peak-to-trough decline of at least `thresh`.\n",
        "    p = price.dropna(); v = p.values; idx = p.index\n",
        "    eps, peak, trough, in_dd = [], 0, 0, False\n",
        "    for i in range(1, len(v)):\n",
        "        if v[i] >= v[peak]:\n",
        "            if in_dd: eps.append((idx[peak], idx[trough], v[trough] / v[peak] - 1))\n",
        "            peak = trough = i; in_dd = False\n",
        "        else:\n",
        "            if v[i] < v[trough]: trough = i\n",
        "            if v[trough] / v[peak] - 1 <= -thresh: in_dd = True\n",
        "    if in_dd: eps.append((idx[peak], idx[trough], v[trough] / v[peak] - 1))\n",
        "    return pd.DataFrame(eps, columns=[\"peak\", \"trough\", \"depth\"])\n",
        "\n",
        "episodes_all = drawdown_episodes(nifty)\n",
        "episodes_all"
      ]
    },
