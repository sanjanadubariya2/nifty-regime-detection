      "source": [
        "episodes = episodes_all[episodes_all.peak >= OOS_START].reset_index(drop=True)\n",
        "\n",
        "ALARMS = {\n",
        "    \"India VIX rule\":           vix > vix.expanding(252).quantile(0.8),\n",
        "    \"200-DMA\":                  (nifty < nifty.rolling(200).mean()).reindex(F.index),\n",
        "    \"HMM base\":                 ema(WF[\"Base (ret, vol)\"][\"p_stress\"]) > 0.5,\n",
        "    \"HMM + VIX\":                ema(WF[\"+ India VIX\"][\"p_stress\"]) > 0.5,\n",
        "    \"HMM + breadth\":            ema(WF[\"+ Breadth & dispersion\"][\"p_stress\"]) > 0.5,\n",
        "    \"HMM full\":                 ema(p_C) > 0.5,\n",
        "    \"(A) full-sample smoothed\": ema(p_A) > 0.5,\n",
        "}\n",
        "\n",
        "def early_warning(alarm):\n",
        "    alarm = alarm.reindex(F.index).fillna(False).astype(bool).loc[OOS_START:]\n",
        "    rows = []\n",
        "    for _, e in episodes.iterrows():\n",
        "        win = alarm.loc[e.peak:e.trough]\n",
        "        hit = win[win]\n",
        "        if len(hit):\n",
        "            d = hit.index[0]\n",
        "            rows.append({\"lag_days\": alarm.index.get_loc(d) - alarm.index.get_loc(e.peak),\n",
        "                         \"fall_at_alarm_%\": (nifty.loc[d] / nifty.loc[e.peak] - 1) * 100, \"missed\": 0})\n",
        "        else:\n",
        "            rows.append({\"lag_days\": np.nan, \"fall_at_alarm_%\": np.nan, \"missed\": 1})\n",
        "    onsets = alarm.index[(alarm & ~alarm.shift(1, fill_value=False)).values]\n",
        "    inside = lambda d: any((d >= e.peak - pd.Timedelta(days=14)) and (d <= e.trough) for _, e in episodes.iterrows())\n",
        "    false = sum(not inside(d) for d in onsets)\n",
        "    yrs = len(alarm) / 252\n",
        "    r = pd.DataFrame(rows, columns=[\"lag_days\", \"fall_at_alarm_%\", \"missed\"])\n",
        "    return {\"episodes\": len(episodes), \"missed\": int(r.missed.sum()) if len(r) else 0,\n",
        "            \"median lag (days)\": r.lag_days.median(), \"median fall at alarm %\": r[\"fall_at_alarm_%\"].median(),\n",
        "            \"false alarms / yr\": false / yrs, \"time in alarm %\": alarm.mean() * 100}\n",
        "\n",
        "print(\"Stress episodes in the out-of-sample period:\")\n",
        "display(episodes)\n",
        "ew_table = pd.DataFrame({k: early_warning(a) for k, a in ALARMS.items()}).T\n",
        "ew_table"
      ]
    },
