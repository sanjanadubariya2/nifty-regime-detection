        "    ax2.fill_between(p_C.loc[a:b].index, ema(p_C).loc[a:b], color=\"tab:red\", alpha=0.25, label=\"P(stress), ours\")\n",
        "    ax2.plot(ema(WF[\"Base (ret, vol)\"][\"p_stress\"]).loc[a:b], color=\"tab:blue\", lw=0.9, label=\"P(stress), base HMM\")\n",
        "    ax2.set_ylim(0, 1.05); ax2.grid(False); ax2.legend(loc=\"lower left\", fontsize=8)\n",
        "plt.tight_layout(); plt.show()"
      ]
    },
