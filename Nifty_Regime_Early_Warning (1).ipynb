      \"std\": 0.30958884583561946,\n        \"min\": 0.3010063949411018,\n        \"max\": 1.2580590091378767,\n        \"num_unique_values\": 8,\n        \"samples\": [\n          0.3010063949411018,\n          0.6780692706088369,\n          0.3172965608145205\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Turnover / yr\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2.758051654560311,\n        \"min\": 0.0,\n        \"max\": 7.7073170731707314,\n        \"num_unique_values\": 7,\n        \"samples\": [\n          0.0,\n          7.219512195121951,\n          6.000314265345041\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
