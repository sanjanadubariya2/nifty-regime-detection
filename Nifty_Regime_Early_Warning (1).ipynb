      "source": [
        "r_eq   = nifty.pct_change().reindex(F.index)\n",
        "r_cash = pd.Series(CASH_YIELD / 252, index=F.index)\n",
        "r_gold = core[\"GOLD\"].pct_change().reindex(F.index).fillna(r_cash) if core[\"GOLD\"].notna().sum() > 500 else r_cash\n",
        "\n",
        "def run_strategy(w, r_rem=r_cash):\n",
        "    w = w.clip(0, 1).reindex(F.index)\n",
        "    held = w.shift(1)                                       # weight decided yesterday\n",
        "    cost = (COST_BPS / 1e4) * w.diff().abs().shift(1)       # trade at close, cost hits next day\n",
        "    r = held * r_eq + (1 - held) * r_rem - cost.fillna(0)\n",
        "    return r.loc[OOS_START:].iloc[1:].dropna(), w.diff().abs().loc[OOS_START:]\n",
        "\n",
        "def hysteresis(p, on=0.6, off=0.4):\n",
        "    out, state = [], 1.0\n",
        "    for x in p.values:\n",
        "        if np.isnan(x): out.append(np.nan); continue\n",
        "        if state == 1.0 and x > on: state = 0.0\n",
        "        elif state == 0.0 and x < off: state = 1.0\n",
        "        out.append(state)\n",
        "    return pd.Series(out, index=p.index)\n",
        "\n",
        "ema = lambda p: p.ewm(span=EMA_SPAN).mean()\n",
        "vix = core[\"INDIAVIX\"].reindex(F.index)\n",
        "rv21 = np.exp(F[\"log_rv21\"])\n",
        "\n",
        "WEIGHTS = {\n",
        "    \"Buy & hold\":                 pd.Series(1.0, index=F.index),\n",
        "    \"India VIX rule\":             (vix <= vix.expanding(252).quantile(0.8)).astype(float),\n",
        "    \"200-DMA\":                    (nifty > nifty.rolling(200).mean()).astype(float).reindex(F.index),\n",
        "    \"Vol targeting\":              (VOL_TARGET / rv21).clip(0, 1),\n",
        "    \"HMM base (prob-weighted)\":   1 - ema(WF[\"Base (ret, vol)\"][\"p_stress\"]),\n",
        "    \"HMM full (prob-weighted)\":   1 - ema(p_C),\n",
        "    \"HMM full (hard switch)\":     hysteresis(ema(p_C)),\n",
        "}\n",
        "\n",
        "def perf(r, turnover=None):\n",
        "    eq = (1 + r).cumprod(); yrs = len(r) / 252\n",
        "    dd = eq / eq.cummax() - 1\n",
        "    ex = r - r_cash.reindex(r.index)\n",
        "    out = {\"CAGR %\": (eq.iloc[-1] ** (1 / yrs) - 1) * 100,\n",
        "           \"Vol %\": r.std() * np.sqrt(252) * 100,\n",
        "           \"Sharpe\": ex.mean() / r.std() * np.sqrt(252),\n",
        "           \"Max DD %\": dd.min() * 100}\n",
        "    out[\"Calmar\"] = out[\"CAGR %\"] / abs(out[\"Max DD %\"])\n",
        "    if turnover is not None: out[\"Turnover / yr\"] = turnover.sum() / yrs\n",
        "    return out\n",
        "\n",
        "RETS, TURN = {}, {}\n",
        "for k, w in WEIGHTS.items():\n",
        "    RETS[k], TURN[k] = run_strategy(w)\n",
        "RETS[\"HMM full (prob-weighted) → gold\"], TURN[\"HMM full (prob-weighted) → gold\"] = run_strategy(WEIGHTS[\"HMM full (prob-weighted)\"], r_gold)\n",
        "\n",
        "common = sorted(set.intersection(*[set(r.index) for r in RETS.values()]))\n",
        "RETS = {k: r.loc[common] for k, r in RETS.items()}\n",
        "perf_table = pd.DataFrame({k: perf(RETS[k], TURN[k]) for k in RETS}).T\n",
        "print(f\"Out-of-sample: {common[0].date()} → {common[-1].date()}   ({len(common)/252:.1f} years)\")\n",
        "perf_table"
      ]
    },
