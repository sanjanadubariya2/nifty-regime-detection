        "def synthetic_data(n=3800, seed=7):\n",
        "    # Offline regime-switching test data. ONLY for checking that the pipeline runs.\n",
        "    rng = np.random.default_rng(seed)\n",
        "    idx = pd.bdate_range(\"2011-01-03\", periods=n)\n",
        "    P = np.array([[0.985, 0.013, 0.002], [0.02, 0.97, 0.01], [0.01, 0.03, 0.96]])\n",
        "    mu = np.array([0.0013, 0.0004, -0.004]); sd = np.array([0.007, 0.011, 0.025])\n",
        "    s = np.zeros(n, int)\n",
        "    for t in range(1, n): s[t] = rng.choice(3, p=P[s[t-1]])\n",
        "    common = rng.normal(mu[s], sd[s])\n",
        "    nifty = 5500 * np.exp(np.cumsum(common))\n",
        "    vix = np.clip(12 + 900 * pd.Series(sd[s]).ewm(span=10).mean().values + rng.normal(0, 1, n), 9, 90)\n",
        "    out = {\"NIFTY\": nifty,\n",
        "           \"BANKNIFTY\": 11000 * np.exp(np.cumsum(1.3 * common + rng.normal(0, 0.005, n))),\n",
        "           \"INDIAVIX\": vix,\n",
        "           \"USDINR\": 45 * np.exp(np.cumsum(0.0001 - 0.15 * common + rng.normal(0, 0.003, n))),\n",
        "           \"GOLD\": 20 * np.exp(np.cumsum(0.0003 - 0.2 * common + rng.normal(0, 0.008, n)))}\n",
        "    core = pd.DataFrame(out, index=idx)\n",
        "    sect = pd.DataFrame({k: 1000 * np.exp(np.cumsum(rng.uniform(0.6, 1.3) * common\n",
        "                         + rng.normal(0, 0.004 + 0.3 * sd[s] * rng.uniform(0.2, 0.6), n)))\n",
        "                         for k in SECTORS}, index=idx)\n",
        "    cons = pd.DataFrame({k: 100 * np.exp(np.cumsum(rng.uniform(0.5, 1.5) * common + rng.normal(0, 0.012, n)))\n",
        "                         for k in CONSTITUENTS[:40]}, index=idx)\n",
        "    return core, sect, cons\n",
        "\n",
        "if USE_SYNTHETIC:\n",
        "    core, sect, cons = synthetic_data()\n",
        "    print(\"Using SYNTHETIC data — results are meaningless, this only tests the pipeline.\")\n",
        "else:\n",
        "    print(\"Downloading / loading cache ...\")\n",
        "    core = pd.concat({k: fetch_close(t) for k, t in CORE.items()}, axis=1)\n",
        "    sect = pd.concat({k: s for k, t in SECTORS.items() if (s := fetch_close(t)) is not None}, axis=1)\n",
        "    cons = pd.concat({t: s for t in CONSTITUENTS if (s := fetch_close(t)) is not None}, axis=1)\n",
        "\n",
        "# Master calendar = Nifty trading days; forward-fill other series for at most a few days\n",
        "cal = core[\"NIFTY\"].dropna().index\n",
        "core = core.reindex(cal).ffill(limit=5)\n",
        "sect = sect.reindex(cal).ffill(limit=5)\n",
        "cons = cons.reindex(cal).ffill(limit=5)\n",
        "core.loc[core[\"INDIAVIX\"] <= 0, \"INDIAVIX\"] = np.nan\n",
        "print(f\"Nifty days: {len(cal)}  ({cal[0].date()} → {cal[-1].date()})\")\n",
        "print(f\"Sectors loaded: {sect.shape[1]}   Breadth stocks loaded: {cons.shape[1]}\")\n",
        "core.tail()"
      ]
    },
